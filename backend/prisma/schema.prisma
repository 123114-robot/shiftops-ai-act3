generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ShiftStatus {
  DRAFT
  SCHEDULED
  CANCELLED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShiftIncidentStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum ShiftProposalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  APPLIED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role UserRole
  employee Employee?
  createdShifts Shift[] @relation("ShiftCreator")
  reviewedLeave LeaveRequest[] @relation("LeaveReviewer")
  createdShiftIncidents ShiftIncident[] @relation("IncidentCreator")
  approvedShiftProposals ShiftProposal[] @relation("ProposalApprover")
  shiftOpsAuditEvents ShiftOpsAuditEvent[] @relation("AuditActor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Employee {
  id String @id @default(cuid())
  userId String? @unique
  user User? @relation(fields: [userId], references: [id])
  firstName String
  lastName String
  email String @unique
  phone String?
  jobTitle String
  status EmployeeStatus @default(ACTIVE)
  availability Availability[]
  leaveRequests LeaveRequest[]
  shifts Shift[]
  replacementProposals ShiftProposal[] @relation("ProposalReplacement")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftIncident {
  id String @id @default(cuid())
  shiftId String
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  reason String
  status ShiftIncidentStatus @default(OPEN)
  createdById String
  createdBy User @relation("IncidentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  proposals ShiftProposal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shiftId, status])
}

model ShiftProposal {
  id String @id @default(cuid())
  incidentId String
  incident ShiftIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  replacementEmployeeId String
  replacementEmployee Employee @relation("ProposalReplacement", fields: [replacementEmployeeId], references: [id], onDelete: Restrict)
  explanation String
  status ShiftProposalStatus @default(PENDING_APPROVAL)
  approvedById String?
  approvedBy User? @relation("ProposalApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt DateTime?
  appliedAt DateTime?
  version Int @default(1)
  shiftUpdatedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([incidentId, status])
}

model ShiftOpsAuditEvent {
  id String @id @default(cuid())
  actorId String
  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action String
  entityId String
  previousStatus String?
  newStatus String
  timestamp DateTime @default(now())
  details Json
  @@index([entityId, timestamp])
}
model Availability {
  id String @id @default(cuid())
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  dayOfWeek DayOfWeek
  startTime String?
  endTime String?
  isAvailable Boolean @default(true)
  @@unique([employeeId, dayOfWeek])
}
model Shift {
  id String @id @default(cuid())
  employeeId String?
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date DateTime @db.Date
  startTime String
  endTime String
  role String
  notes String?
  status ShiftStatus @default(DRAFT)
  createdById String
  createdBy User @relation("ShiftCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  incidents ShiftIncident[]
  @@index([date])
  @@index([employeeId, date])
}
model LeaveRequest {
  id String @id @default(cuid())
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  reason String
  status LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedBy User? @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([employeeId, startDate, endDate])
}
